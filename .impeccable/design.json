      "html": "<details class=\"ds-details\"><summary>Behind the project<svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></summary><p>This interactive study demonstrates part of the interface concept.</p></details>",
      "css": ".ds-details{font-family:var(--font-sans),Archivo,sans-serif;color:var(--ink,#edf0e7);max-width:280px}.ds-details summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:44px;font-size:12px;border-block:1px solid var(--line,#ffffff21)}.ds-details summary::-webkit-details-marker{display:none}.ds-details summary:hover{color:var(--accent,#d2e8ab)}.ds-details summary:focus-visible{outline:2px solid var(--accent,#d2e8ab);outline-offset:5px;}.ds-details[open] svg{transform:rotate(45deg)}.ds-details p{font-size:12px;line-height:1.6;color:var(--muted,#a4afa2);margin-top:15px}"
