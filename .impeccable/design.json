      "css": ".ds-theme{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line,#ffffff21);border-radius:50%;background:transparent;color:var(--ink,#edf0e7);cursor:pointer;transition:background-color 200ms,transform 160ms}.ds-theme:hover{background:var(--surface-raised,#222922)}.ds-theme:focus-visible{outline:2px solid var(--accent,#d2e8ab);outline-offset:5px;}.ds-theme:active{transform:scale(.97)}"
